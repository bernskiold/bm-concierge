{
  "name": "bernskioldmedia/bm-concierge",
  "description": "Our help at your fingertips. BM Concierge lets you easily access content and assistive service for your site, right from the dashboard.",
  "type": "wordpress-plugin",
  "homepage": "https://bernskiold.com",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bernskiold Media",
      "email": "info@bernskioldmedia.com"
    }
  ],
  "support": {
    "source": "https://github.com/bernskiold/bm-concierge",
    "issues": "https://github.com/bernskiold/bm-concierge/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "composer/installers": "^2.3",
    "deeplcom/deepl-php": "^1.21",
    "yahnis-elsts/plugin-update-checker": "^6.0"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "BernskioldMedia\\WP\\Concierge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BernskioldMedia\\WP\\Concierge\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint-fix": "phpcbf",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.2"
    }
  }
}
