{
  "name": "bm-concierge",
  "private": true,
  "version": "1.1.1",
  "description": "Our help at your fingertips. BM Concierge lets you easily access content and assistive service for your site, right from the dashboard.",
  "scripts": {
    "setup": "npm install && composer install && npm run build",
    "release": "npm ci && composer install --no-dev -o && npm run build",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "npm run start",
    "format": "wp-scripts format ./assets/src ./tests/unit",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js ./assets/src ./tests/unit",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "i18n": "npm run i18n:pot",
    "i18n:pot": "npm run build && wp i18n make-pot . ./languages/bm-concierge.pot --include=\"dist/,src/\"",
    "i18n:json": "wp i18n make-json languages --no-purge",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "packages-update": "wp-scripts packages-update",
    "test": "npm run test:unit",
    "test:unit": "wp-scripts test-unit-js",
    "test:unit:watch": "wp-scripts test-unit-js --watch",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/bm-concierge composer test",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "author": {
    "name": "Bernskiold Media",
    "email": "info@bernskioldmedia.com",
    "url": "https://bernskioldmedia.com",
    "role": "developer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernskiold/bm-concierge.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/bernskiold/bm-concierge/issues"
  },
  "homepage": "https://github.com/bernskiold/bm-concierge#readme",
  "devDependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/editor": "^16.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/plugins": "^8.1.0",
    "@wordpress/scripts": "^37.1.0",
    "@wordpress/wordcount": "^5.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
